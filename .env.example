# APRIL Configuration

# OpenAI-compatible API Configuration
OPENAI_API_KEY=your_api_key_here
OPENAI_API_BASE_URL=http://localhost:11434/v1
OPENAI_MODEL=mistral

# Runtime
APRIL_PERSONA=april
APRIL_MEMORY_DB=./data/april_memory.db
APRIL_WORKSPACE=.
# Comma-separated learning targets: memory, device, workflow
APRIL_LEARN_TARGETS=

# Devices (read-only telemetry): id=url,id=url
APRIL_ESP32_DEVICES=

# MCP registry (git-ignored runtime state)
APRIL_MCP_REGISTRY=.ade/mcp_servers.json

# Hooks: workspace hooks are untrusted unless this is 1
APRIL_TRUST_WORKSPACE_HOOKS=0

# Cost estimates (USD per 1k tokens; blank -> builtin map / zero)
APRIL_COST_IN_PER_1K=
APRIL_COST_OUT_PER_1K=
